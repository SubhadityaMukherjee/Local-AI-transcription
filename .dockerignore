.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project specific
vendor/  # Will be populated at runtime by docker-entrypoint.sh
recordings/
outputs/
uploads/
store/
.env
*.log

# Tests
tests/
.pytest_cache/
coverage/

# Documentation
README.md
!README.md  # Keep if needed

# CI/CD
.github/
.gitlab-ci.yml
